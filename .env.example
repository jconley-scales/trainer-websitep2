# Copy to .env.local (git-ignored) and fill in. NEVER commit real keys.
#
# Local development: run `npx supabase start` from this folder, then
# `npx supabase status` for the URL and keys. `npx supabase db reset` applies
# the migrations in supabase/migrations/.
#
# Hosted Supabase: project URL and keys from Project Settings -> API. Paste
# supabase/templates/magic_link.html into Auth -> Email Templates -> Magic Link
# so the trainer's sign-in email contains a code, and turn OFF "Allow new users
# to sign up" (Auth -> Providers -> Email).

# --- Site (browser + server) ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Scripts only (never used by the running site) -----------------------
# `npm run admin:add -- you@example.com` uses this to create the trainer's
# account and add it to the admins list. It bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- New-booking email to the trainer -------------------------------------
# Any SMTP provider works. Locally, the Supabase mail viewer catches mail on
# port 54325 (view it at http://127.0.0.1:54324); no user/password needed.
# Leave SMTP_HOST empty to skip the email (bookings are still saved).
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
BOOKING_NOTIFY_EMAIL=trainer@example.com
BOOKING_FROM_EMAIL=bookings@example.com
# Used for the link to /admin in the email.
SITE_URL=http://localhost:3000
