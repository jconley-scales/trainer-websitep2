# Copy to .env.local (git-ignored) and fill in. NEVER commit real keys.
#
# Local development: run `npx supabase start`, then copy the values it prints
# (`npx supabase status`): API URL, anon key, service_role key, DB URL and JWT
# secret. The local stack's keys are well-known demo keys, only valid locally.
#
# Hosted Supabase: take the project URL, anon key and service_role key from
# Project Settings -> API, and the Postgres connection string from Project
# Settings -> Database. Also paste the OTP email templates from
# supabase/templates/ into Auth -> Email Templates (Confirm signup and Magic
# Link), otherwise users receive a link instead of the 6-digit code the login
# screen asks for.

# Browser + server: project URL and public (anon) key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. REQUIRED at runtime: lib/supabase/admin.ts uses it to create the
# client's profile during login (verifyCode); without it login fails for
# everyone. Never expose it to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Tests and the seed script only (not used by the running app): direct Postgres
# connection, and the JWT secret the DB/RLS tests use to sign test tokens.
SUPABASE_DB_URL=postgresql://postgres:your-db-password@127.0.0.1:54322/postgres
SUPABASE_JWT_SECRET=your-jwt-secret

# Seed script only (`npm run seed`): id of the trainer's profile row (an
# existing profiles.id with role = 'trainer') that the slots belong to.
SEED_TRAINER_ID=00000000-0000-0000-0000-000000000000
